# ASSURA_* settings are canonical. Existing LEGALMATE_* settings are accepted
# as fallbacks; an explicit ASSURA_* value (including empty) takes priority.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_8901m2a5v4rgeffbaaatcsgnhe38

# Isolated native workflow. Keep disabled until a tested version and stable
# authenticated client-tool bridge are configured. No NEXT_PUBLIC_ variables.
ASSURA_WORKFLOW_ENABLED=false
ELEVENLABS_WORKFLOW_AGENT_ID=
ELEVENLABS_WORKFLOW_VERSION_ID=

# AI2 assessment stage. Server only; never prefix either variable with NEXT_PUBLIC_.
OPENAI_API_KEY=
ASSURA_AI2_MODEL=gpt-5.6-terra

# App authentication. See docs/authentication.md; never commit real secrets.
ASSURA_PUBLIC_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
ASSURA_EMAIL_FROM=

# Optional shared password for the two fixed test accounts only.
# Workflow testing can initialize a missing TestProvider on first valid test login.
# When enabled, it is prefilled on the homepage for all signed-out visitors.
ASSURA_TEST_PASSWORD=

# Optional HTTPS or mailto link for new service provider enquiries.
ASSURA_CONTACT_URL=
