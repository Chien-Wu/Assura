[Unit]
Description=Build and deploy the latest Assura main branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/assura/deployment.env
ExecStart=/usr/local/lib/assura/deploy.sh
TimeoutStartSec=30min
TimeoutStopSec=180
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
