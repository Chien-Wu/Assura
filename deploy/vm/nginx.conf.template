server {
    listen 80;
    server_name __HOST__;
    location /.well-known/acme-challenge/ {
        root /var/www/assura-acme;
    }
    location / { return 301 https://__HOST__$request_uri; }
}

server {
    listen 443 ssl;
    server_name __HOST__;
    ssl_certificate /etc/assura/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/assura/letsencrypt/live/__HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        if (-f /var/lib/assura/maintenance) { return 503; }
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host __HOST__;
        proxy_set_header X-Forwarded-Host __HOST__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Rate limiting trusts only this proxy-supplied client address.
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header Authorization "";
        # Identity comes only from the application session cookie.
        proxy_set_header oai-authenticated-user-id "";
        proxy_set_header oai-authenticated-user-email "";
        proxy_set_header oai-authenticated-user-full-name "";
        proxy_set_header oai-authenticated-user-full-name-encoding "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
