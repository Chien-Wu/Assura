server {
    listen 80;
    server_name __HOST__;
    location /.well-known/acme-challenge/ {
        root /var/www/legalmate-acme;
    }
    location / { return 301 https://__HOST__$request_uri; }
}

server {
    listen 443 ssl;
    server_name __HOST__;
    ssl_certificate /etc/legalmate/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/legalmate/letsencrypt/live/__HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    auth_basic "LegalMate testing";
    auth_basic_user_file /etc/legalmate/users.htpasswd;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location = /signin-with-chatgpt { return 302 /worker; }
    location = /signout-with-chatgpt { return 401; }

    location / {
        if (-f /var/lib/legalmate/maintenance) { return 503; }
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host __HOST__;
        proxy_set_header X-Forwarded-Host __HOST__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header oai-authenticated-user-id "vm_$remote_user";
        proxy_set_header oai-authenticated-user-email "$remote_user@legalmate.local";
        proxy_set_header oai-authenticated-user-full-name "$remote_user";
        proxy_set_header oai-authenticated-user-full-name-encoding "percent-encoded-utf-8";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
