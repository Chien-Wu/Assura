{
  "name": "legalmate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "node tests/notes-api.mjs && node tests/voice-api.mjs && node tests/safety-api.mjs",
    "test:live": "node --experimental-strip-types tests/text-conversation.mjs",
    "format": "prettier --write app lib db tests docs README.md package.json tsconfig.json eslint.config.mjs",
    "format:check": "prettier --check app lib db tests docs README.md package.json tsconfig.json eslint.config.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:onboarding": "node --experimental-strip-types tests/onboarding-api.mjs",
    "test:knowledge": "node --experimental-strip-types tests/knowledge-api.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@elevenlabs/react": "1.15.2",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
